      "active": true
    },
    {
      "id": "u_7ce2313617a9616b38ce195c_0",
      "kind": "td",
      "source": "The provider's servers (Anthropic, OpenAI, Google, DeepSeek). OpenRouter passes each message on to the lab that runs the chosen model, according to the privacy settings of your OpenRouter account.",
      "sourceHash": "7ce2313617a9616b38ce195ccb707d3529bc6704b2cd9763587353f86633ac92",
      "context": "Privacy > Where your notes go",
      "contextHash": "6230e3b7dee5b6118cc577e6fdf5821af9d7fe96121f5cb235a4e23b49049bec",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_0ce6fb2f5e36d421ed404e07_0",
      "kind": "td",
      "source": "Subscription-based",
      "sourceHash": "0ce6fb2f5e36d421ed404e07c1f8384c428a0e2e6f3a171a4e90df0416df3a9a",
      "context": "Privacy > Where your notes go",
      "contextHash": "6230e3b7dee5b6118cc577e6fdf5821af9d7fe96121f5cb235a4e23b49049bec",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_26105c665de19eaa30f48330_0",
      "kind": "td",
      "source": "The provider's servers, via Claude Code running locally",
      "sourceHash": "26105c665de19eaa30f48330014f84fb84c9e119c5e6488ad6f93fae3a7eec92",
      "context": "Privacy > Where your notes go",
      "contextHash": "6230e3b7dee5b6118cc577e6fdf5821af9d7fe96121f5cb235a4e23b49049bec",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_b2887919f2f7bad98aed2183_0",
      "kind": "td",
      "source": "Local / self-hosted",
      "sourceHash": "b2887919f2f7bad98aed21831c0b260c90a1e8b4592fc231cb46056f0fbdbe45",
      "context": "Privacy > Where your notes go",
      "contextHash": "6230e3b7dee5b6118cc577e6fdf5821af9d7fe96121f5cb235a4e23b49049bec",
