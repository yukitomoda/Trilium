    {
      "id": "u_fa47294b0e18bb8fac359289_0",
      "kind": "p",
      "source": "Sometimes the SQL Console cannot be used (for example if the application cannot start).",
      "sourceHash": "fa47294b0e18bb8fac35928943dab40edcdfb6263284274d3eec65db4638cfac",
      "context": "Manually altering the database > Externally modifying the database",
      "contextHash": "7891f3e4828254c070fbb11e54a5bf2ea9e4d3dc3108235f712b94a04029dac1",
      "status": "translated",
      "active": true,
      "translation": "SQLコンソールが使用できない場合もあります（アプリケーションを起動できない場合など）。",
