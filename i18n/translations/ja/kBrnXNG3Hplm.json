    {
      "id": "u_563e390d46fb443b860c1a76_0",
      "kind": "p",
      "source": "A note is the central entity in TriliumNext. For more details, see __TRILIUM_PH_0__Notes__TRILIUM_PH_1__.",
      "sourceHash": "563e390d46fb443b860c1a7695e8b868e1cb3ba5ddb0b127fdf83101b78aed7c",
