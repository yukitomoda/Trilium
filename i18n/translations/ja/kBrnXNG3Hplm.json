    {
      "id": "u_891e887c05bd605f8c0d6b00_0",
      "kind": "p",
      "source": "A subtree consists of a particular note (the subtree root) and all its children and descendants. Some operations, such as exporting, work on entire subtrees.",
      "sourceHash": "891e887c05bd605f8c0d6b00919e17a6afc97e4fa82d003ad1594d612e77a005",
      "context": "Tree Concepts > Subtree",
      "contextHash": "03fe9df74ba71fab3d86acf41db2162aa151a3013c16c10dd96eaf6314f51561",
