    {
      "id": "u_e859e30f7d797a09951511de_0",
      "kind": "li",
      "source": "Franz Kafka: Die Verwandlung, 1915",
      "sourceHash": "e859e30f7d797a09951511def347d43eab9de33a69c9e78870cbb53287911b65",
      "context": "Default Note Title",
      "contextHash": "27cab928b981c71f55038d17a78b948ef5bc1065de8cc1981f96a55e79728069",
