    {
      "id": "u_cf823d2922bb4aa243e1d9c8_0",
      "kind": "li",
      "source": "To delete the layout together with its content, click the handle at its top-left corner to select it, then press __TRILIUM_PH_0__Delete__TRILIUM_PH_1__.",
