    {
      "id": "u_b545eddc0f961d84c47e3ef5_0",
      "kind": "li",
      "source": "Choosing a layout with more columns adds empty columns at the end.",
      "sourceHash": "b545eddc0f961d84c47e3ef571fcb6379556f1fe6e7c52a31c326f80e05f4995",
      "context": "Multicolumn layout > Changing the columns > Changing the layout",
      "contextHash": "b7714fa922f51852fd0b013aded6b5557b7eab1be413f4405847aaba8cc6f67a",
      "status": "translated",
      "active": true,
      "translation": "より多くの列を持つレイアウトを選択すると、末尾に空の列が追加されます。",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
        "glossaryHash": "87275a9e032d2599a1276554b41c0fed0509e3ed6ee1594f83705051d453ee50"
      },
      "translatedAt": "2026-11-14T14:14:05.465Z"
    },
    {
      "id": "u_615f1a29f7f6763b6362885f_0",
      "kind": "li",
      "source": "Choosing a layout with fewer columns removes the last columns and moves their content to the end of the last remaining column.",
      "sourceHash": "615f1a29f7f6763b6362885fd60c1e54e55b304cbc41070c389cfa6151122f11",
      "context": "Multicolumn layout > Changing the columns > Changing the layout",
      "contextHash": "b7714fa922f51852fd0b013aded6b5557b7eab1be413f4405847aaba8cc6f67a",
      "status": "translated",
      "active": true,
      "translation": "より少ない列を持つレイアウトを選択すると、最後の列が削除され、そのコンテンツが残った最後の列の末尾に移動します。",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
        "glossaryHash": "87275a9e032d2599a1276554b41c0fed0509e3ed6ee1594f83705051d453ee50"
      },
      "translatedAt": "2026-11-14T14:14:05.465Z"
    },
