      "translatedAt": "2026-11-16T11:52:29.295Z"
    },
    {
      "id": "u_74b6148f587372424bf67531_0",
      "kind": "p",
      "source": "The columns of a new layout have equal widths. If text is selected when the layout is inserted, the selection moves into the first column.",
      "sourceHash": "74b6148f587372424bf67531e0558380e58cfd909a168944c7a055ee49b076ab",
      "context": "Multicolumn layout > Inserting a layout",
      "contextHash": "592c6894d32db61271bfb9b405aaeb3a46974f2ffc629a0c536b6bb26497cb67",
      "status": "translated",
      "active": true,
      "translation": "新しいレイアウトの各列の幅は均等になります。レイアウトの挿入時にテキストが選択されている場合、その選択範囲は最初の列に移動します。",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
