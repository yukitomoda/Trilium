    {
      "id": "u_2ed39e2c3b14ef5fb9036e59_0",
      "kind": "p",
      "source": "A multicolumn layout arranges content in two to four columns, side by side. A column can hold any kind of content, including tables, images and another multicolumn layout.",
      "sourceHash": "2ed39e2c3b14ef5fb9036e5921fe779468ad0c9d68efedb668384140238dddb8",
      "context": "Multicolumn layout",
      "contextHash": "a8529d33c36c23a1e902908eaeea40ce3942bfdb828bf8bf562247fe8a7dea7f",
      "status": "translated",
      "active": true,
      "translation": "マルチカラムレイアウトを使用すると、コンテンツを2〜4列に並べて配置できます。1つの列には、テーブル、画像、別のマルチカラムレイアウトなど、あらゆる種類のコンテンツを配置できます。",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
        "glossaryHash": "87275a9e032d2599a1276554b41c0fed0509e3ed6ee1594f83705051d453ee50"
      },
      "translatedAt": "2026-11-14T16:50:34.717Z"
    },
    {
