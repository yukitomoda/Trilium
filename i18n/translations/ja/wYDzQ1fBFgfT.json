    {
      "id": "u_1c847acc5c5c4da7eba71165_0",
      "kind": "p",
      "source": "When a layout has too little room for its columns (narrower than about 500 pixels, such as on a phone), the columns are stacked one below the other. While editing, alternating background colors tell the columns apart. This applies to each layout on its own, so a layout inside a narrow column is stacked while the outer one stays side by side.",
      "sourceHash": "1c847acc5c5c4da7eba7116594aa1f0ca902a85adcbc7231a7fcc5e3c5ef2ee7",
      "context": "Multicolumn layout > Narrow screens",
      "contextHash": "aea8362f12a26a6cc2971a804758c3c4f38112828b2a8b31db3ee39e2bf670b7",
      "status": "translated",
      "active": true,
      "translation": "レイアウトの列に対して十分なスペースがない場合（スマートフォンなど、約500ピクセルより狭い場合）、列は上下に積み重ねて表示されます。編集中には、背景色が交互に変わることで列が区別しやすくなります。これはレイアウトごとに個別に適用されるため、狭い列内にあるレイアウトは積み重ねられ、外側のレイアウトは並んで表示されたままになります。",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
        "glossaryHash": "87275a9e032d2599a1276554b41c0fed0509e3ed6ee1594f83705051d453ee50"
      },
      "translatedAt": "2026-11-14T14:14:05.465Z"
    },
