    {
      "id": "u_76978f752963f81607609866_0",
      "kind": "p",
      "source": "There are numerous keyboard shortcuts to format the text without having to use the mouse. For a reference of all the key combinations, see __TRILIUM_PH_0__Keyboard Shortcuts__TRILIUM_PH_1__. In addition, see __TRILIUM_PH_2__Markdown-like formatting__TRILIUM_PH_3__ as an alternative to the keyboard shortcuts.",
      "sourceHash": "76978f752963f81607609866bb7713ec4dcde1f482af3f7d3c40eaeda1dcf4ce",
      "context": "Text > Keyboard shortcuts",
      "contextHash": "0348ca8b974d68dfdd4abcfa06df9e01802e71e631c4704bc42b3648220ff052",
      "status": "pending",
      "active": true
    },
