    {
      "id": "u_7c5cc978d7a6459f54e4831e_0",
      "kind": "p",
      "source": "Text notes are usually opened in edit mode. However, they may open in read-only mode if the note is too big or the note is explicitly marked as read-only. For more information, see __TRILIUM_PH_0__Read-Only Notes__TRILIUM_PH_1__.",
      "sourceHash": "7c5cc978d7a6459f54e4831e203eca44dc67694196f1ac440c4ca3b8015d5c12",
      "context": "Text > Read-Only vs. Editing Mode",
      "contextHash": "150ae9871288eef1246437c6d701e8a4b547a2e9063ecad108aff771a0c474f5",
      "status": "pending",
      "active": true
    },
