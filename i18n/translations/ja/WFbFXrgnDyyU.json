    {
      "id": "u_5a0624d1d19b33078d955e80_0",
      "kind": "p",
      "source": "Trilium Notes does not collect/send any data from the user's installation, i.e. no analytics, no telemetry etc. The data flows only between user controlled / installed applications, without any intermediary.",
      "sourceHash": "5a0624d1d19b33078d955e80f1fc387d114579a7c566bfdba5c9d7033c4eb0bd",
      "context": "Privacy Policy > Trilium Notes",
      "contextHash": "8ac61c2926c56bc41927cd25bb624d40ce80769cf9a058d68029914c410150e1",
      "status": "translated",
      "active": true,
      "translation": "Trilium Notesは、ユーザーのインストール環境からデータを収集・送信することはありません（アナリティクスやテレメトリーなどは一切ありません）。データは、仲介者を介さず、ユーザーが管理・インストールしたアプリケーション間でのみやり取りされます。",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
