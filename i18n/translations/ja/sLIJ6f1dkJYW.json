    {
      "id": "u_0fca10d721a756b411c69bd3_0",
      "kind": "p",
      "source": "It might be desirable to only expose the share functionality of Trilium to the Internet, and keep the application accessible only within a local network or via VPN.",
      "sourceHash": "0fca10d721a756b411c69bd3cc0ce917d2f9f9a54b6a0323e32804805a61b6c3",
      "context": "Reverse proxy configuration",
      "contextHash": "2919b721405a774ed6940ce4f10d0f51f1fc6622d09c5d45de87a88ee4383d3d",
      "status": "translated",
      "active": true,
      "translation": "Triliumの共有機能のみをインターネットに公開し、アプリケーション本体にはローカルネットワーク内またはVPN経由でのみアクセスできるようにすることが望ましい場合があります。",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
        "glossaryHash": "87275a9e032d2599a1276554b41c0fed0509e3ed6ee1594f83705051d453ee50"
      },
      "translatedAt": "2026-11-14T14:14:05.465Z"
    },
    {
      "id": "u_b057a18b56af82b1134ad5d6_0",
      "kind": "p",
      "source": "To do so, a reverse proxy is required.",
      "sourceHash": "b057a18b56af82b1134ad5d6fd5d7697b44274935077c09acb84cb5561f64587",
      "context": "Reverse proxy configuration",
      "contextHash": "2919b721405a774ed6940ce4f10d0f51f1fc6622d09c5d45de87a88ee4383d3d",
      "status": "translated",
      "active": true,
      "translation": "これを行うには、リバースプロキシが必要です。",
      "conditions": {
