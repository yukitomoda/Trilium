    {
      "id": "u_2bf2c57afc3c3752afbeaf8e_0",
      "kind": "h2",
      "source": "Reporting issues__TRILIUM_PH_0__",
      "sourceHash": "2bf2c57afc3c3752afbeaf8e05bfb59300f5f1bf42573dc5359a53fbe63cb560",
      "context": "Microsoft OneNote > Reporting issues",
      "contextHash": "442be9517ced609944632f4ea862d0886ccc8214e528421d79154a3d1262f1ec",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_10ceabedaa3d63c36d9eccd1_0",
      "kind": "p",
      "source": "When importing notes, you might find that some text is not rendered properly or the structure is not properly maintained. As long as this issue is not a fundamental issue (like the issue with freehand text not being preserved exactly), it's a good idea to __TRILIUM_PH_0__report it__TRILIUM_PH_1__.",
      "sourceHash": "10ceabedaa3d63c36d9eccd1af98205b5f478fe9b893bc9b2ef984b0b3d76f2d",
      "context": "Microsoft OneNote > Reporting issues",
      "contextHash": "442be9517ced609944632f4ea862d0886ccc8214e528421d79154a3d1262f1ec",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_4c628d0e14697d7196eebf0b_0",
      "kind": "p",
      "source": "When reporting, make sure that you provide the following information:",
      "sourceHash": "4c628d0e14697d7196eebf0b7bffdbb6efa441d7c072acb133a584c490265d3f",
      "context": "Microsoft OneNote > Reporting issues",
      "contextHash": "442be9517ced609944632f4ea862d0886ccc8214e528421d79154a3d1262f1ec",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_26637123659c0ab9586625cf_0",
      "kind": "li",
      "source": "Import again the section, checking the debug checkbox before importing. This preserves the original document (and the hand-drawing data if any) as it came through from OneNote's cloud API so that it can be used for comparison.",
      "sourceHash": "26637123659c0ab9586625cf70e684c4bef0921ab0cf7fc0aa6105308f91fde9",
      "context": "Microsoft OneNote > Reporting issues",
      "contextHash": "442be9517ced609944632f4ea862d0886ccc8214e528421d79154a3d1262f1ec",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_7deded9609db750ba49c96a0_0",
      "kind": "li",
      "source": "Export only the affected page as ZIP, making sure not to accidentally expose any sensitive information.",
      "sourceHash": "7deded9609db750ba49c96a00410543c3e617ace88d794c5f56dd245ba0652b4",
      "context": "Microsoft OneNote > Reporting issues",
      "contextHash": "442be9517ced609944632f4ea862d0886ccc8214e528421d79154a3d1262f1ec",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_afd2f4df874a91ce73ea633c_0",
      "kind": "li",
      "source": "Take screenshots of how the note looked like in OneNote and how it ends up in Trilium.",
      "sourceHash": "afd2f4df874a91ce73ea633c7f0741124ed41566dd552cb0e033599fdacc4396",
      "context": "Microsoft OneNote > Reporting issues",
      "contextHash": "442be9517ced609944632f4ea862d0886ccc8214e528421d79154a3d1262f1ec",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_267f38369bc18f064990b59b_0",
      "kind": "li",
      "source": "Attach the ZIP and the screenshots to the issue report.",
      "sourceHash": "267f38369bc18f064990b59bd1fb2756861ae6ab06c08016b8aa2d523b574a5e",
      "context": "Microsoft OneNote > Reporting issues",
      "contextHash": "442be9517ced609944632f4ea862d0886ccc8214e528421d79154a3d1262f1ec",
      "status": "pending",
      "active": true
    }
