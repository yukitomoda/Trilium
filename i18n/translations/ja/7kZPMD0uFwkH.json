    {
      "id": "u_375f1da3fa57c70bde3c3a43_0",
      "kind": "li",
      "source": "Open the Google Forms in a browser.",
      "sourceHash": "375f1da3fa57c70bde3c3a43efb2e8908014b13f3c9ad106aeec9099618ec7cd",
      "context": "Downloading responses from Google Forms > Obtaining the CSV link",
      "contextHash": "d573cc0b69c52e38bb9431850e2160176f5ebd2ce6328c4fb98abf0a2ec52c73",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_48dbfabfc6f2d77b8f8f99f2_0",
      "kind": "li",
      "source": "Select the “Responses” tab and click on “Link to Sheets”.",
      "sourceHash": "48dbfabfc6f2d77b8f8f99f213e3f6277c91d2cca71e285c7b97b493e237f598",
      "context": "Downloading responses from Google Forms > Obtaining the CSV link",
      "contextHash": "d573cc0b69c52e38bb9431850e2160176f5ebd2ce6328c4fb98abf0a2ec52c73",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_1b2430f5f545e99b79d29c35_0",
      "kind": "li",
      "source": "Select “Create a new spreadsheet” and press “Create”.",
      "sourceHash": "1b2430f5f545e99b79d29c359dd7111b9679f01694768f715a3cbd9e96bf29d7",
      "context": "Downloading responses from Google Forms > Obtaining the CSV link",
      "contextHash": "d573cc0b69c52e38bb9431850e2160176f5ebd2ce6328c4fb98abf0a2ec52c73",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_056d961c948ddae217d3125f_0",
      "kind": "li",
      "source": "In Google Sheets, select File → Share → Publish to web.",
      "sourceHash": "056d961c948ddae217d3125f99b79bbe7ef235863c5ab7f7c53b1373c0fb90fc",
      "context": "Downloading responses from Google Forms > Obtaining the CSV link",
      "contextHash": "d573cc0b69c52e38bb9431850e2160176f5ebd2ce6328c4fb98abf0a2ec52c73",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_2f3a024bc3e51bfd8bc8018a_0",
      "kind": "li",
      "source": "In the “Publish to the web” screen, make sure the “Link” tab is selected and instead of “Web page”, select “Comma-separated values (.csv)”.",
      "sourceHash": "2f3a024bc3e51bfd8bc8018a9e0cd3b0ae601e0595ef3ec0646aabf41e472a0a",
      "context": "Downloading responses from Google Forms > Obtaining the CSV link",
      "contextHash": "d573cc0b69c52e38bb9431850e2160176f5ebd2ce6328c4fb98abf0a2ec52c73",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_36a1750fe7bb49853c0975a0_0",
      "kind": "li",
      "source": "Copy the given link which will be used for the upcoming script.",
      "sourceHash": "36a1750fe7bb49853c0975a04c6c050947072dae51730a5e34f4d4594804cf89",
