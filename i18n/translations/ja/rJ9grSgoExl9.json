    {
      "id": "u_f399961ec8364a01e4605205_0",
      "kind": "p",
      "source": "__TRILIUM_PH_0__GitHub-Flavored Markdown__TRILIUM_PH_1__ is the main syntax that Trilium is following.",
      "sourceHash": "f399961ec8364a01e4605205223e34a2871f51d863a9b82576702278a52b7a67",
      "context": "Supported syntax",
