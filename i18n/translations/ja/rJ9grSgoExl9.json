    {
      "id": "u_bd478e7fa219b92af145a971_0",
      "kind": "p",
      "source": "Background highlights are supported in two ways:",
      "sourceHash": "bd478e7fa219b92af145a9719c97fbd332894a189679e6d3fbe72cc4944a2455",
      "context": "Supported syntax > Highlights",
      "contextHash": "2300722d598345c0157a7e2b5ab2ec3e5d977f740ac5972edae0c0c13379c012",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_b23113c02557f643b138edb9_0",
      "kind": "p",
      "source": "The Markdown __TRILIUM_PH_0__ extension which is supported by other Markdown-based applications such as Obsidian:",
      "sourceHash": "b23113c02557f643b138edb908a1937b5d5aa0ce21f1ee974c83bb78d22788c9",
      "context": "Supported syntax > Highlights",
      "contextHash": "2300722d598345c0157a7e2b5ab2ec3e5d977f740ac5972edae0c0c13379c012",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_732d127567855e61c6230cc9_0",
      "kind": "p",
      "source": "The canonical HTML representation of highlights, as supported by Trilium:",
      "sourceHash": "732d127567855e61c6230cc9ff642bdc19bab63b08caeafd78374c3968ba9002",
      "context": "Supported syntax > Highlights",
      "contextHash": "2300722d598345c0157a7e2b5ab2ec3e5d977f740ac5972edae0c0c13379c012",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_6450a0432c5d9268149745fb_0",
      "kind": "p",
      "source": "When the yellow highlight is used, import/export prefers the __TRILIUM_PH_0__ syntax whereas the canonical HTML reprepresentation is used otherwise.",
      "sourceHash": "6450a0432c5d9268149745fb881f3152fe35b87f09b0a0aefefae497ef304bf2",
      "context": "Supported syntax > Highlights",
      "contextHash": "2300722d598345c0157a7e2b5ab2ec3e5d977f740ac5972edae0c0c13379c012",
      "status": "pending",
      "active": true
    }
  ],
