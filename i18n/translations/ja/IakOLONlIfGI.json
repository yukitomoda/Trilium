      "status": "pending",
      "active": true
    },
    {
      "id": "u_361991e2dfb70237862ca099_0",
      "kind": "p",
      "source": "With clones, it might not be immediately obvious how deleting works.",
      "sourceHash": "361991e2dfb70237862ca0991cb9224c2c2bef8699bfad1d085b8acbf245493f",
      "context": "Cloning Notes > Deleting notes/clones",
      "contextHash": "6b11d9402531d623496be94097a711d915ba49778df29ac10b0f0d159ab970fa",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_768b68218434030e5cfdee13_0",
      "kind": "p",
      "source": "If you try to delete a note, it works like this:",
      "sourceHash": "768b68218434030e5cfdee134534fe065bb90046694d62a51b37546763b00512",
      "context": "Cloning Notes > Deleting notes/clones",
      "contextHash": "6b11d9402531d623496be94097a711d915ba49778df29ac10b0f0d159ab970fa",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_5a2c90154b55fc9b99cbc301_0",
      "kind": "li",
      "source": "if the note has multiple clones, delete just this clone and leave the actual note (and its other clones) as it is.",
      "sourceHash": "5a2c90154b55fc9b99cbc301d208cc65c2dd3b07239ca0cdfb3d5c0502a6939c",
      "context": "Cloning Notes > Deleting notes/clones",
      "contextHash": "6b11d9402531d623496be94097a711d915ba49778df29ac10b0f0d159ab970fa",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_25583e94bf7e1995b895c660_0",
      "kind": "li",
      "source": "if this note doesn't have any other clones, delete the note",
      "sourceHash": "25583e94bf7e1995b895c66054db76711c0c4f153e6851afbd0e1c377e28f31a",
      "context": "Cloning Notes > Deleting notes/clones",
      "contextHash": "6b11d9402531d623496be94097a711d915ba49778df29ac10b0f0d159ab970fa",
      "status": "pending",
      "active": true
    },
    {
