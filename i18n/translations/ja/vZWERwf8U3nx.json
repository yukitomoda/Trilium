      "status": "pending",
      "active": true
    },
    {
      "id": "u_e864a3ec3074185cacafe22a_0",
      "kind": "p",
      "source": "To turn off note versioning for a particular note (or sub-tree), add __TRILIUM_PH_0__ __TRILIUM_PH_1__label__TRILIUM_PH_2__ to the note.",
      "sourceHash": "e864a3ec3074185cacafe22a935201290d0cd38630e000c062fbcc6d9ade8b2e",
      "context": "Note Revisions > When revisions are saved > Snapshot interval",
      "contextHash": "b7d79515141774b81ed17063614cb3b189e6806dccb2cdf232ee7e6ce97c606e",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_6641de58760796eb0c740ef5_0",
      "kind": "h4",
      "source": "Maximum revisions__TRILIUM_PH_0__",
      "sourceHash": "6641de58760796eb0c740ef553e5a029c714bb745170065f18ebe9021a2f5741",
      "context": "Note Revisions > When revisions are saved > Maximum revisions",
