    {
      "id": "u_97bdcee711cc6b2d58335205_0",
      "kind": "p",
      "source": "Time interval of taking note snapshot is configurable in the Options → Other dialog. This provides a trade-off between more revisions and more data to store.",
      "sourceHash": "97bdcee711cc6b2d583352052e2b4be5b5e624716412f01926a94bb65ccd6c52",
      "context": "Note Revisions > When revisions are saved > Snapshot interval",
