    {
      "id": "u_b496290131fe459b8d8cd990_0",
      "kind": "li",
      "source": "Whenever a snippet is created, deleted or its title/description are modified, all the open text notes will need to be refreshed. This causes a slight flash for usually under a second, but it can cause some discomfort.",
      "sourceHash": "b496290131fe459b8d8cd9901cc116e3edbcbffc5766554aecdcf6de7667bcad",
      "context": "Text Snippets > Limitations",
      "contextHash": "5afc5f05ddc4f615cd24910ea09e41884926035846936bb05e24278de79688a4",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_e0cbd56b698fd5f82ea08b0b_0",
      "kind": "li",
      "source": "Unlike __TRILIUM_PH_0__Templates__TRILIUM_PH_1__, the snippets cannot be limited to a particular __TRILIUM_PH_2__workspace__TRILIUM_PH_3__.",
      "sourceHash": "e0cbd56b698fd5f82ea08b0b4afb5108d919834f79f451cc4af5a559707826bc",
      "context": "Text Snippets > Limitations",
      "contextHash": "5afc5f05ddc4f615cd24910ea09e41884926035846936bb05e24278de79688a4",
      "status": "pending",
