    {
      "id": "u_77629db98b742ad58cb2b723_0",
      "kind": "p",
      "source": "Text Snippets are closely related to __TRILIUM_PH_0__Templates__TRILIUM_PH_1__, but instead of defining the content of an entire note, text snippets are pieces of formatted text that can easily be inserted in a text note.",
      "sourceHash": "77629db98b742ad58cb2b723b5569b485d3ee6cf318231c3f915b9a50ca05080",
      "context": "Text Snippets",
      "contextHash": "12a9386461599990f7bccf40c65c3fd3c5a202ae5c098069dcff2326813201c8",
      "status": "pending",
      "active": true
    },
