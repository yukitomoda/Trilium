    {
      "id": "u_bb107472b58ad35866971d16_0",
      "kind": "p",
      "source": "If you don't feel comfortable attaching the logs or anything sensitive to the public GitHub issues, feel free to contact the devs in our Matrix __TRILIUM_PH_0__support channel__TRILIUM_PH_1__.",
      "sourceHash": "bb107472b58ad35866971d1641f50ebf4426aee33a3c8e9325a5a3fa598581d9",
      "context": "Error logs > Providing sensitive data",
