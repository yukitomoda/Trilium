    {
      "id": "u_7f5b640932477b9882f74cc7_0",
      "kind": "p",
      "source": "It's important to provide all available error logs together with bug reports.",
      "sourceHash": "7f5b640932477b9882f74cc7fd2b4f1e1b70aef35057eac881c383a767dc19e7",
