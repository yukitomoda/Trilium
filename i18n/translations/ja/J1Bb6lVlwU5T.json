      "context": "Manually > Requirements",
      "contextHash": "d54f84041972f07b2de72a48adc38f1372b983eb4850a29cbb920a2cd191b9fa",
      "status": "translated",
      "active": true,
      "translation": "以下のコマンドでnodeのバージョンを確認できます（node.jsがインストールされている必要があります）：",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
        "glossaryHash": "87275a9e032d2599a1276554b41c0fed0509e3ed6ee1594f83705051d453ee50"
