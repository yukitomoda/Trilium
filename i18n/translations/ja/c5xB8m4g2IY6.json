    },
    {
      "id": "u_a5ba69f7bd827af02c1e5814_0",
      "kind": "h2",
      "source": "Limiting script runs based on instance__TRILIUM_PH_0__",
      "sourceHash": "a5ba69f7bd827af02c1e5814ebe92d47fcc9e4e362f6d75cee660f4f361afab4",
      "context": "Trilium instance > Limiting script runs based on instance",
      "contextHash": "067309013fddd59ad967ab106ee0220985fa9d1c4a351db65a14bb13cf23d2d9",
      "status": "translated",
      "active": true,
      "translation": "インスタンスに基づいたスクリプト実行の制限__TRILIUM_PH_0__",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
        "glossaryHash": "87275a9e032d2599a1276554b41c0fed0509e3ed6ee1594f83705051d453ee50"
