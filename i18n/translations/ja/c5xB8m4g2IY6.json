      "contextHash": "c62fb0cf8cc20abf51e5d89e24a31eb4a512827ce07d953ecf4c7bf62ef86d07",
      "status": "translated",
      "active": true,
      "translation": "インスタンスの名前を設定するには、__TRILIUM_PH_0__を次のように変更します。",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
