    {
      "id": "u_72502eaac9b5728857048b85_0",
      "kind": "p",
      "source": "Note context-aware widgets are a different type of widget which automatically react to changes in the current note.",
      "sourceHash": "72502eaac9b5728857048b859044b07ece4ce2140849763955b5c81a721d6bb3",
      "context": "Note context aware widget",
      "contextHash": "38056d8742b2d4f4fce0e19f55548ded8e2a764925ff72e67fe97f75bbd76e36",
      "status": "translated",
      "active": true,
      "translation": "ノートコンテキスト対応ウィジェットは、現在のノートの変更に自動的に反応する別タイプのウィジェットです。",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
        "glossaryHash": "87275a9e032d2599a1276554b41c0fed0509e3ed6ee1594f83705051d453ee50"
      },
      "translatedAt": "2026-11-14T14:14:05.465Z"
    },
    {
      "id": "u_ed2cbe2a4a1c5964d31b9e13_0",
      "kind": "p",
      "source": "Important aspects:",
      "sourceHash": "ed2cbe2a4a1c5964d31b9e130633837cc4a64d8f14a08b5c7bd64730b0f9789a",
      "context": "Note context aware widget",
