    {
      "id": "u_fa6aec78eff6208d5a988eaf_0",
      "kind": "li",
      "source": "SSH into your server",
      "sourceHash": "fa6aec78eff6208d5a988eaf5a49dd956d690d103b453dfdd52d8f39026d2c21",
      "context": "Packaged version for Linux > Steps",
      "contextHash": "6bbbcdba61f98a6d7a1c96f9d8afb4ab0842c7c443cb4c50819185a5aec8d5df",
      "status": "translated",
      "active": true,
      "translation": "サーバーにSSH接続します",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
