    },
    {
      "id": "u_c56029a500f5b4e67860c43a_0",
      "kind": "li",
      "source": "__TRILIUM_PH_0__Connections tab__TRILIUM_PH_1__, which groups together the note map, note paths, backlinks and similar notes.",
      "sourceHash": "c56029a500f5b4e67860c43a40c9e3256d27141959cdb33c90dd6f84bd2b2583",
      "context": "Right Sidebar",
      "contextHash": "5bfb84fd2e71a9812465bcdc862cefcfd19a6f89982d95b3cdd24e1dd1130630",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_d1ce778ae39c38f23ddd2447_0",
      "kind": "p",
      "source": "Each window keeps its own selected tab, so switching tabs in one window does not affect the others. A newly opened window starts on the tab that was selected last.",
      "sourceHash": "d1ce778ae39c38f23ddd244705cfdfeea4f3e48b2cab26e11cc62401495df433",
      "context": "Right Sidebar",
      "contextHash": "5bfb84fd2e71a9812465bcdc862cefcfd19a6f89982d95b3cdd24e1dd1130630",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_61fdc243aee9240293856df5_0",
      "kind": "h2",
      "source": "Toggling the right sidebar__TRILIUM_PH_0__",
      "sourceHash": "61fdc243aee9240293856df59d94cb9e5603af37f59ecc36b3f6a3b9e5eb77fb",
      "context": "Right Sidebar > Toggling the right sidebar",
