    {
      "id": "u_ab5fb5de0a551b00c4e90156_0",
      "kind": "p",
      "source": "The right sidebar displays specific content for the current note. The sidebar is grouped into multiple tabs:",
      "sourceHash": "ab5fb5de0a551b00c4e901566b762fbb6f108d1df5d9a296dcc4a0a95454c09c",
      "context": "Right Sidebar",
      "contextHash": "5bfb84fd2e71a9812465bcdc862cefcfd19a6f89982d95b3cdd24e1dd1130630",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_f48cae9a3b39935f3ede462b_0",
      "kind": "li",
      "source": "__TRILIUM_PH_0__Outline tab__TRILIUM_PH_1__, which displays the table of contents, highlights and other navigation-related sections depending on the note type.",
      "sourceHash": "f48cae9a3b39935f3ede462b9700a198d82c75c279af054223dc41fb6a3be149",
      "context": "Right Sidebar",
      "contextHash": "5bfb84fd2e71a9812465bcdc862cefcfd19a6f89982d95b3cdd24e1dd1130630",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_46c8ead2b190dd17ef57bdca_0",
      "kind": "li",
      "source": "__TRILIUM_PH_0__Attributes tab__TRILIUM_PH_1__, which provides a visual editor for the current note's __TRILIUM_PH_2__Attributes__TRILIUM_PH_3__.",
      "sourceHash": "46c8ead2b190dd17ef57bdca42bad40b0c0db8fc77df68ed49997a18f5b829b9",
      "context": "Right Sidebar",
      "contextHash": "5bfb84fd2e71a9812465bcdc862cefcfd19a6f89982d95b3cdd24e1dd1130630",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_462fe0a1bdad789118b1348a_0",
      "kind": "li",
      "source": "__TRILIUM_PH_0__AI chat tab__TRILIUM_PH_1__, which uses the __TRILIUM_PH_2__AI__TRILIUM_PH_3__ integration to chat, with optional access to the current note.",
      "sourceHash": "462fe0a1bdad789118b1348a4dc6be866e4dbe16c60c273cc1dfc9eea20d9b1f",
      "context": "Right Sidebar",
      "contextHash": "5bfb84fd2e71a9812465bcdc862cefcfd19a6f89982d95b3cdd24e1dd1130630",
