      "active": true
    },
    {
      "id": "u_4215a27c5b3dc7c8caac4900_0",
      "kind": "li",
      "source": "This will permanently erase all the __TRILIUM_PH_0__Note Revisions__TRILIUM_PH_1__ of the notes. Unlike deleted notes, erased revisions cannot be restored.",
