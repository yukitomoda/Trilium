      "contextHash": "de78cf97cf58bb730420b2c74d6996b850bfe147fa535cedf436a2563762d7fb",
      "status": "translated",
      "active": true,
      "translation": "図形が作成されると：",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
