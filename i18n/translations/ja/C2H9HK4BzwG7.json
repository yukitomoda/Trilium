      "kind": "h3",
      "source": "Finishing and cancelling__TRILIUM_PH_0__",
      "sourceHash": "882ac2853d5bddf0c9c7d61e435c0d3a7934297f2c06952d63708abb3859ef81",
      "context": "Drawing shapes > Drawing a shape on the map > Finishing and cancelling",
