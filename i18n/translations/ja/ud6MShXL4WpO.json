    {
      "id": "u_7f4f8b439b266082792cdde5_0",
      "kind": "li",
      "source": "add the __TRILIUM_PH_0__ directive with the same path: this allows you to stay logged in at multiple instances at the same time.",
      "sourceHash": "7f4f8b439b266082792cdde5968ee43749347107c030f72a5dc0fe9179ab1844",
      "context": "Nginx > Serving under a different path",
      "contextHash": "0c59443b06b4642c81dd3c01e625f7b944565ce7d8a00998783bef935f629f67",
      "status": "translated",
      "active": true,
      "translation": "同じパスを指定した__TRILIUM_PH_0__ディレクティブを追加します。これにより、複数のインスタンスに同時にログインした状態を維持できます。",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
