      "status": "pending",
      "active": true
    },
    {
      "id": "u_049629c50d3fd43a7b184a43_0",
      "kind": "p",
      "source": "For more advanced behaviors that do not require a user interface (e.g. batch modifying notes), see __TRILIUM_PH_0__Backend scripts__TRILIUM_PH_1__.",
