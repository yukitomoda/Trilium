    {
      "id": "u_b25d7a45d68046eb44586c97_0",
      "kind": "td",
      "source": "This allows rendering custom content inside a note, using either HTML or Preact JSX.",
      "sourceHash": "b25d7a45d68046eb44586c9793f0584f350a592cdda5462dcb93bcdfa67817d2",
      "context": "Frontend Basics",
