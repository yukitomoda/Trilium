    {
      "id": "u_f8b299162984ba747ca8e7fa_0",
      "kind": "td",
      "source": "These can introduce new UI elements in various positions, such as near the __TRILIUM_PH_0__Note Tree__TRILIUM_PH_1__, content area or even the __TRILIUM_PH_2__Right Sidebar__TRILIUM_PH_3__.",
      "sourceHash": "f8b299162984ba747ca8e7fa54cb12d41f5a61fe06f4e38d449efd4186676e32",
      "context": "Frontend Basics",
      "contextHash": "f6b7a4b19af6c4164a602c841c2ccbc384bc2e5f5fc4d967ed33dfecb9a1355b",
      "status": "pending",
      "active": true
    },
    {
