    {
      "id": "u_c23bd9fd261d0d59b7b8332d_0",
      "kind": "p",
      "source": "Scripts don't have any special requirements. They can be run manually using the __TRILIUM_PH_0__Execute__TRILIUM_PH_1__ button on the code note or they can be run automatically, see __TRILIUM_PH_2__Frontend Events__TRILIUM_PH_3__.",
      "sourceHash": "c23bd9fd261d0d59b7b8332d5a2e69f5b91911a468172d15c189cb2ee4bf9611",
      "context": "Frontend Basics > Scripts",
