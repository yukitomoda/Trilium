    {
      "id": "u_caabac5201909f8f578ace06_0",
      "kind": "p",
      "source": "Downloaded resources are large files that some features need but that do not ship with Trilium, such as the speech recognition models used to transcribe meetings. Trilium downloads them the first time a feature needs them, and keeps them on the device for later use.",
      "sourceHash": "caabac5201909f8f578ace0669a558f951808a3f00f7b85710ecfdf582ec11d5",
      "context": "Downloaded resources",
      "contextHash": "44d319d7463bfabda0ef5a32f67e2ef582c7cec7733cb8962d9299b62ffcfc99",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_9b0097d1fa520638c7cda787_0",
      "kind": "p",
      "source": "Currently, only __TRILIUM_PH_0__Meeting transcription__TRILIUM_PH_1__ on the desktop application uses downloaded resources:",
