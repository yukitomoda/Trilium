    {
      "id": "u_c4cc7b4f6c63ed45b71a4d16_0",
      "kind": "li",
      "source": "For some view types, such as Grid view, only a subset of notes will be displayed and pagination can be used to navigate through all of them for performance reasons. To adjust the number of notes per page, set __TRILIUM_PH_0__ to the desired number.",
      "sourceHash": "c4cc7b4f6c63ed45b71a4d1657273bab0fb46a6cb3fd5c0cd4d05d1385ae2e11",
      "context": "Note List > Configuration",
