    {
      "id": "u_cadfa18a9fef7d0e8c0ed673_0",
      "kind": "li",
      "source": "To hide the note list for a particular note, simply apply the __TRILIUM_PH_0__ __TRILIUM_PH_1__label__TRILIUM_PH_2__.",
      "sourceHash": "cadfa18a9fef7d0e8c0ed6734374bad1eef1efbd57c3fea7a9af2efc222b58e6",
      "context": "Note List > Configuration",
