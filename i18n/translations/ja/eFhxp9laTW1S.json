    },
    {
      "id": "u_8615abffea7d754cfb053ff7_1",
      "kind": "li",
      "source": "by adding the unpacked folder to your PATH, or",
      "sourceHash": "8615abffea7d754cfb053ff7c511933d988617b4647a388bfe0707b8a238222f",
      "context": "Subscription-based providers >  Google Antigravity",
      "contextHash": "48373d2daaa7a28a2ece157a823dcfd27fd5641e72345c1e35a39733fd7117aa",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_42e4509948bc8e791915c28b_1",
      "kind": "li",
      "source": "by setting a __TRILIUM_PH_0__ environment variable pointing to __TRILIUM_PH_1__.",
      "sourceHash": "42e4509948bc8e791915c28b8479f5937a852c09e2af2da656a0d3a8798533d4",
      "context": "Subscription-based providers >  Google Antigravity",
      "contextHash": "48373d2daaa7a28a2ece157a823dcfd27fd5641e72345c1e35a39733fd7117aa",
      "status": "pending",
      "active": true
