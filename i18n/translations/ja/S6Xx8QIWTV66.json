    {
      "id": "u_ff54b334762a5d3fc0378096_0",
      "kind": "p",
      "source": "A list item can be centered or aligned to the right, either with the text alignment button in the formatting toolbar or by aligning the __TRILIUM_PH_0__Tables__TRILIUM_PH_1__ cell that contains the list. The bullet, number or checkbox then moves together with the text of the item.",
      "sourceHash": "ff54b334762a5d3fc0378096f0b923af94322b9bfed804c048047ba9008070e1",
      "context": "Lists > Alignment",
      "contextHash": "cfe69769c6d86cbe0f42be488bd79a60564a2adbf60ded21c58f2d539999b680",
