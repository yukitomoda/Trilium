    {
      "id": "u_3e9c2cd25f370966059a2e08_0",
      "kind": "p",
      "source": "Trilium encrypts the data within protected notes but not their metadata. Specifically:",
      "sourceHash": "3e9c2cd25f370966059a2e08dfc20e028c3a5d06aef9c284160f128f514abcf2",
