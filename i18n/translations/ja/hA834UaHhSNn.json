    {
      "id": "u_2a38e21e950b91992c3b407f_0",
      "kind": "h2",
      "source": "Ignoring a code script from a bundle__TRILIUM_PH_0__",
      "sourceHash": "2a38e21e950b91992c3b407f8b9036792e4f3d8f7bb596379f3058525e11025f",
      "context": "Script bundles > Ignoring a code script from a bundle",
