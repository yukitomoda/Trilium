    {
      "id": "u_bad1a02d372cb2810771238f_0",
      "kind": "p",
      "source": "When __TRILIUM_PH_0__Script with dependency__TRILIUM_PH_1__ is run, it will detect __TRILIUM_PH_2__MyMath__TRILIUM_PH_3__ as a submodule and provide the result of its __TRILIUM_PH_4__ object into a global object with the same name as the note.",
      "sourceHash": "bad1a02d372cb2810771238fe5dff873ca5bc031b274db793a93a60ddbc29624",
      "context": "Script bundles",
      "contextHash": "b5dbc4d8c244a3badb06f1199001917726fd3726a763d8c102aab9336c5335bb",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_db4c931c595b655f37de7f23_0",
      "kind": "p",
      "source": "If the note contains spaces or special characters, they will be stripped. For example __TRILIUM_PH_0__ becomes __TRILIUM_PH_1__.",
      "sourceHash": "db4c931c595b655f37de7f23eb6125c9ee2ff807c699809c84989be6bf5603ff",
      "context": "Script bundles",
      "contextHash": "b5dbc4d8c244a3badb06f1199001917726fd3726a763d8c102aab9336c5335bb",
      "status": "pending",
      "active": true
    },
    {
