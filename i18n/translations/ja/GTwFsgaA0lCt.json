    {
      "id": "u_eb3376e5b0eb617fa3c79998_0",
      "kind": "p",
      "source": "__TRILIUM_PH_0__Presentation__TRILIUM_PH_1__ which shows each note as a slide and can be presented full-screen with smooth transitions or exported to PDF for sharing.",
      "sourceHash": "eb3376e5b0eb617fa3c7999858504a2081e002ed683cf8421e94780c7dc36c44",
      "context": "Collections > Main collections",
