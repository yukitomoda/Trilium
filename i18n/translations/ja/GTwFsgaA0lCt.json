    },
    {
      "id": "u_4d10cb60909eb0f1cfc6b5ba_0",
      "kind": "p",
      "source": "__TRILIUM_PH_0__Geo Map__TRILIUM_PH_1__ which displays a geographical map in which the notes are represented as pins on the map. New markers can be easily added by pointing on the map. In addition __TRILIUM_PH_2__shapes__TRILIUM_PH_3__ such as paths, rectangles and circles can be added, as well as GPX tracks.",
      "sourceHash": "4d10cb60909eb0f1cfc6b5baea7aa71f38c050eb7d1065b764803a4375edb69f",
      "context": "Collections > Main collections",
      "contextHash": "fc87cecb7863ccab62bce3b2b3d42ee63dbf886f06ea1c3bf40b643fc6f3e1da",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_82c18dd02b0f5bfbcef86f2f_0",
      "kind": "p",
      "source": "__TRILIUM_PH_0__ Presentation",
      "sourceHash": "82c18dd02b0f5bfbcef86f2fcf80f9d52d31f27bfe577cba7faae895175a2061",
