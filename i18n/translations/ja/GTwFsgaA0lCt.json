      "active": true
    },
    {
      "id": "u_63b5b4dbdf08fb684445e048_0",
      "kind": "p",
      "source": "__TRILIUM_PH_0__Table__TRILIUM_PH_1__ displays each note as a row in a table, with __TRILIUM_PH_2__Promoted Attributes__TRILIUM_PH_3__ being shown as well. This makes it easy to visualize attributes of notes, as well as making them easily editable.",
      "sourceHash": "63b5b4dbdf08fb684445e048f1894d0755c8016ae007466975042bd8668a70d0",
      "context": "Collections > Main collections",
      "contextHash": "fc87cecb7863ccab62bce3b2b3d42ee63dbf886f06ea1c3bf40b643fc6f3e1da",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_9f705c7ef0f907cdd4673c35_0",
      "kind": "p",
      "source": "__TRILIUM_PH_0__ Kanban Board",
      "sourceHash": "9f705c7ef0f907cdd4673c35e4c068982f250cb51386d948a0ead6e8779c0651",
      "context": "Collections > Main collections",
