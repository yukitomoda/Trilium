    {
      "id": "u_12843278dfa2cf20256791de_0",
      "kind": "p",
      "source": "__TRILIUM_PH_0__Kanban Board__TRILIUM_PH_1__ displays notes in columns, grouped by the value of a label. Items and columns can easily be created or dragged around to change their status.",
      "sourceHash": "12843278dfa2cf20256791de8f6cb06569df8793d573335d0aa1530ac85b2904",
      "context": "Collections > Main collections",
      "contextHash": "fc87cecb7863ccab62bce3b2b3d42ee63dbf886f06ea1c3bf40b643fc6f3e1da",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_8da88ce1ad87b25975648536_0",
      "kind": "p",
      "source": "__TRILIUM_PH_0__ Geo Map",
