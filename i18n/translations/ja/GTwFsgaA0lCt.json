    {
      "id": "u_97771dee53f39a22011b37a8_0",
      "kind": "li",
      "source": "Change the __TRILIUM_PH_0__note type__TRILIUM_PH_1__ from __TRILIUM_PH_2__Collection__TRILIUM_PH_3__ to __TRILIUM_PH_4__Text__TRILIUM_PH_5__.",
      "sourceHash": "97771dee53f39a22011b37a890cf9c3a450e80df49448a1141dedfafb9ec62d3",
      "context": "Collections > Advanced use cases > Adding a description to a collection",
