      "id": "u_90122a3612fba26984ba1894_0",
      "kind": "p",
      "source": "Collections are a unique type of note that don't have content, but instead display their child notes in various presentation methods.",
      "sourceHash": "90122a3612fba26984ba189443ee782b2d75be95a7d74d5b82a7a93c50c4d5af",
      "context": "Collections",
      "contextHash": "9f9feade761d22f340a4de9c586f222aa74658351faadc8365335bc3c548ba71",
