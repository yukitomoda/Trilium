      "status": "pending",
      "active": true
    },
    {
      "id": "u_19dbb49f546ee33d5d7bc876_0",
      "kind": "li",
      "source": "Similarly, clicking on the __TRILIUM_PH_0__ button of a footnote will navigate to the corresponding reference in the text.",
