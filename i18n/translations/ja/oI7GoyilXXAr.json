    {
      "id": "u_fe897d21585113ff22dd25b3_0",
      "kind": "li",
      "source": "The text to replace is matched literally; it is not a pattern.",
      "sourceHash": "fe897d21585113ff22dd25b3b253c18b9946d452343aebb855e49365441b89fe",
      "context": "Automatic replacements > Custom replacements",
      "contextHash": "ebc7d0a0720dc5c0d35bdd448ef4557daa426fc1fc3c1f798a05602140933cdb",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_19934c6690f186aa2ea80efd_0",
      "kind": "li",
      "source": "Typing a \"text to replace\" that already exists in the list of replacements will update the existing one instead. It's not possible to have multiple replacements for the same text.",
      "sourceHash": "19934c6690f186aa2ea80efdbfd54e2808d172e6a8395a72f2ec6b34eced80d3",
      "context": "Automatic replacements > Custom replacements",
      "contextHash": "ebc7d0a0720dc5c0d35bdd448ef4557daa426fc1fc3c1f798a05602140933cdb",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_61975a02d8fb6545a8ec33d6_0",
      "kind": "li",
      "source": "The same “text to replace” with different capitalization (e.g. __TRILIUM_PH_0__ and __TRILIUM_PH_1__ co-existing) doesn't work because it would interfere with the capitalization rules above.",
      "sourceHash": "61975a02d8fb6545a8ec33d69f05f08be5aec865b7bdea3955d724b155f9a933",
      "context": "Automatic replacements > Custom replacements",
      "contextHash": "ebc7d0a0720dc5c0d35bdd448ef4557daa426fc1fc3c1f798a05602140933cdb",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_c35241608c0740229e6f9853_0",
      "kind": "h2",
      "source": "Characters that only look replaced (ligatures)__TRILIUM_PH_0__",
      "sourceHash": "c35241608c0740229e6f985367b1aeb88d0335ab0e28b8f01467e1f7d745ac24",
      "context": "Automatic replacements > Characters that only look replaced (ligatures)",
