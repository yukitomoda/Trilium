    {
      "id": "u_9fabe18368328ad3fb5681a5_0",
      "kind": "p",
      "source": "Trilium comes with a large set of custom hooks for Preact, all of which are also available to custom widgets and __TRILIUM_PH_0__Render Note__TRILIUM_PH_1__.",
      "sourceHash": "9fabe18368328ad3fb5681a57b09ebb4a5d461265929642320d7e8d88d911ed8",
