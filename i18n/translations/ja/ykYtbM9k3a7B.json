    },
    {
      "id": "u_5226d954735816f19bb31541_0",
      "kind": "p",
      "source": "This hook allows “listening” for changes to a particular property of a __TRILIUM_PH_0__, such as the __TRILIUM_PH_1__ or __TRILIUM_PH_2__ of a note. The benefit from using the hook is that it actually reacts to changes, for example if the note title or type is changed.",
      "sourceHash": "5226d954735816f19bb31541ca0be2222c361f8e55875d58b0e0e3bcb20502c1",
