      "id": "u_2a3f6adec4e219846df4186e_0",
      "kind": "p",
      "source": "Optical Character Recognition is the process in which the text from images or PDFs is extracted.",
      "sourceHash": "2a3f6adec4e219846df4186ee77c9baf147df2fcf77a598c2bdac046239ee457",
      "context": "Text Extraction (OCR)",
      "contextHash": "2536c1ee3e037b7a11b72b6ce8828f7aaa10178501dc14a80be4cbaaea202121",
      "status": "pending",
      "active": true
    },
    {
