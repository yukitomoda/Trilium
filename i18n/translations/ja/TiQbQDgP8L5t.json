      "status": "pending",
      "active": true
    },
    {
      "id": "u_9e1f3dfab50101cd940425f5_0",
      "kind": "li",
      "source": "The underlying technology is Tesseract.js.",
      "sourceHash": "9e1f3dfab50101cd940425f5b7ce6bb77092aae425b976267ee5a4e654338167",
      "context": "Text Extraction (OCR) > Supported formats > Images",
