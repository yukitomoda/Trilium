    {
      "id": "u_c4bee48ec3e0ba2bff1c79fc_0",
      "kind": "p",
      "source": "Since v0.103.0, Trilium has built-in support for OCR. The extracted text can be:",
      "sourceHash": "c4bee48ec3e0ba2bff1c79fc994a1a6ada41531630ec41e626516c1755aef2b2",
      "context": "Text Extraction (OCR) > Built-in support",
      "contextHash": "5b81c705ae5e45abc76df7dbc42616e34a60402906655991c4995b749c776b25",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_51a77c225bd679fb35d96eb8_0",
      "kind": "li",
      "source": "Integrated with __TRILIUM_PH_0__Search__TRILIUM_PH_1__, to quickly find the image or file based on snippets of text.",
      "sourceHash": "51a77c225bd679fb35d96eb8c5ab05e220eb3dd20e9ed542a0eb34a053cb1de2",
      "context": "Text Extraction (OCR) > Built-in support",
      "contextHash": "5b81c705ae5e45abc76df7dbc42616e34a60402906655991c4995b749c776b25",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_7beb7faafd506308815ea5e5_0",
      "kind": "li",
      "source": "Integrated with the __TRILIUM_PH_0__AI__TRILIUM_PH_1__ feature, which allows the agent to access the content of a non-text note.",
      "sourceHash": "7beb7faafd506308815ea5e5389f3079ac2daf9ae1789483078dd31ede76c0db",
      "context": "Text Extraction (OCR) > Built-in support",
      "contextHash": "5b81c705ae5e45abc76df7dbc42616e34a60402906655991c4995b749c776b25",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_9150e4f076a4928b90b4416e_0",
      "kind": "li",
      "source": "Manually accessed for other purposes (e.g. copying into a note or sending it somewhere else).",
      "sourceHash": "9150e4f076a4928b90b4416e6b01181b0e778b974c3ce90ad1ba18972b58bdc8",
      "context": "Text Extraction (OCR) > Built-in support",
      "contextHash": "5b81c705ae5e45abc76df7dbc42616e34a60402906655991c4995b749c776b25",
      "status": "pending",
