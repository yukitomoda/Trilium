    {
      "id": "u_d02ece12d1f5d3b4265319c7_0",
      "kind": "h3",
      "source": "PDFs__TRILIUM_PH_0__",
      "sourceHash": "d02ece12d1f5d3b4265319c7bc05828a823f44aa8a3326525cf2d8c264a87e7a",
      "context": "Text Extraction (OCR) > Supported formats > PDFs",
      "contextHash": "8f4cdcb0516d1d182824368055960e943ed893df5a1c76bf64605fc92d3ae613",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_01ab6f0c850e0a0a802b2497_0",
      "kind": "p",
      "source": "The PDF extraction supports:",
      "sourceHash": "01ab6f0c850e0a0a802b249728daebbf5a21bb8308bff01ff207ae61578a8c36",
      "context": "Text Extraction (OCR) > Supported formats > PDFs",
      "contextHash": "8f4cdcb0516d1d182824368055960e943ed893df5a1c76bf64605fc92d3ae613",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_781c46e520c8057877bef64e_0",
      "kind": "li",
      "source": "PDFs with text information (e.g. a PDF created by a browser or a word processing application), in which the text is extracted.",
      "sourceHash": "781c46e520c8057877bef64e8bc34cd27119bcd64357ab8f6bcc40a36ac32882",
      "context": "Text Extraction (OCR) > Supported formats > PDFs",
      "contextHash": "8f4cdcb0516d1d182824368055960e943ed893df5a1c76bf64605fc92d3ae613",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_7ab6e84d780f3efe5853373b_0",
      "kind": "li",
      "source": "Scanned PDFs, and other PDFs whose text cannot be selected (such as documents whose text was converted to outlines), in which the text is extracted through an OCR process.",
      "sourceHash": "7ab6e84d780f3efe5853373b04448f032ec5b358ac3e1c85f5b905361c24f24a",
      "context": "Text Extraction (OCR) > Supported formats > PDFs",
      "contextHash": "8f4cdcb0516d1d182824368055960e943ed893df5a1c76bf64605fc92d3ae613",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_86bd62926c0d7bd2bf3945ba_0",
      "kind": "li",
      "source": "Mixed PDFs, containing both text and images with text content.",
      "sourceHash": "86bd62926c0d7bd2bf3945baa349e278ab34a96268b31120069c228def70dbe4",
      "context": "Text Extraction (OCR) > Supported formats > PDFs",
      "contextHash": "8f4cdcb0516d1d182824368055960e943ed893df5a1c76bf64605fc92d3ae613",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_6b31151ab7027f423c72a901_0",
      "kind": "p",
      "source": "Note that OCR extraction is limited to 50 pages per PDF, pages containing text information (not as an image) are not subject to this limitation.",
      "sourceHash": "6b31151ab7027f423c72a90151e59d0e3cfff892788bcbbbe04809ba64f05df6",
      "context": "Text Extraction (OCR) > Supported formats > PDFs",
      "contextHash": "8f4cdcb0516d1d182824368055960e943ed893df5a1c76bf64605fc92d3ae613",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_ef5df80f78fab911a90334f5_0",
      "kind": "p",
      "source": "Text extraction for scanned PDFs using OCR was introduced in v0.106.0. If a scanned PDF was already processed by an earlier version, reprocess it individually via __TRILIUM_PH_0__Process OCR__TRILIUM_PH_1__; batch processing only handles files that haven't been OCR'd yet.",
      "sourceHash": "ef5df80f78fab911a90334f5d73b193d8c11fcfb6647d7592c4ba22a5c54ffcb",
      "context": "Text Extraction (OCR) > Supported formats > PDFs",
      "contextHash": "8f4cdcb0516d1d182824368055960e943ed893df5a1c76bf64605fc92d3ae613",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_c2a75440bf5823d0dcfd725a_0",
      "kind": "h3",
      "source": "Office documents__TRILIUM_PH_0__",
      "sourceHash": "c2a75440bf5823d0dcfd725aaa252a69d45eecfc07cc6e118c835a8c475516dc",
