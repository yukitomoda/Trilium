    {
      "id": "u_c666301ccf6ed5d1b00ccb6d_0",
      "kind": "li",
      "source": "Note that this feature works best for computer-rendered text rather than handwriting.",
      "sourceHash": "c666301ccf6ed5d1b00ccb6d28c1f1132ddadec5f216e7d1478bd41b06152140",
      "context": "Text Extraction (OCR) > Supported formats > Images",
