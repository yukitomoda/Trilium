    {
      "id": "u_c646db5b89e976599258af25_0",
      "kind": "p",
      "source": "CKEditor ships some plugins as premium (slash commands, templates, AI integration). Initially Trilium (since v0.96.0) shipped some of them like slash commands as part of a license grant from CKEditor to the Trilium Notes developers.",
      "sourceHash": "c646db5b89e976599258af25fce64bb7c6d090514ed25b108ec6de39cd693852",
      "context": "CKEditor > Premium features",
      "contextHash": "f66f77a0fb89a78cbf85fcd037cfb3b4dbc1238aaed33a0ab05a0371287173c4",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_d3d3cb64503184f0dabe8319_0",
      "kind": "p",
      "source": "In v0.105.0 we've decided to replace those premium plugins with our own open-source implementations. This also means that we can better tailor those plugins to the Trilium app.",
      "sourceHash": "d3d3cb64503184f0dabe8319e90c3ce1bb08bb78d8f0484af8e3f4ed3e32751f",
      "context": "CKEditor > Premium features",
      "contextHash": "f66f77a0fb89a78cbf85fcd037cfb3b4dbc1238aaed33a0ab05a0371287173c4",
      "status": "pending",
      "active": true
    },
