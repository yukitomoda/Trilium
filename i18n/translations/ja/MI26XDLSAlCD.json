    {
      "id": "u_6a3fb6f1233782424317794e_0",
      "kind": "p",
      "source": "CKEditor by itself is a commercial product, but the core is open-source. As described in __TRILIUM_PH_0__its documentation__TRILIUM_PH_1__, the editor supports quite a large number of features. Do note that not all the features are enabled in Trilium.",
      "sourceHash": "6a3fb6f1233782424317794ef8a56a3767e271004083fc303a511a37812043d3",
      "context": "CKEditor > Editor core",
      "contextHash": "c3593e74e19b8a36ba603183e2ad3729f95bb09c4a64c43b082f08d074459519",
      "status": "pending",
      "active": true
    },
    {
