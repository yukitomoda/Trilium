    {
      "id": "u_87d0eeabb6de889b68fba58d_0",
      "kind": "h2",
      "source": "Trilium only shows a blank window__TRILIUM_PH_0__",
      "sourceHash": "87d0eeabb6de889b68fba58d651e975508322b69e885a97874404f5930e0bea6",
      "context": "Troubleshooting > Trilium only shows a blank window",
