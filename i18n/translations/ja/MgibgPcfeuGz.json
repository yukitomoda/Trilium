    {
      "id": "u_57ede022ea44291045a4ea6e_0",
      "kind": "li",
      "source": "JSX for Preact widgets. You might need to go to Options → Code to enable the language first.",
      "sourceHash": "57ede022ea44291045a4ea6e7ad5df2cbfa7ed57c0c57cb74df6e5b7ecacec2b",
