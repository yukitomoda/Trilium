    {
      "id": "u_5d4118d0bc0422d0f47f2f49_0",
      "kind": "li",
      "source": "Apply the __TRILIUM_PH_0__ __TRILIUM_PH_1__label__TRILIUM_PH_2__.",
      "sourceHash": "5d4118d0bc0422d0f47f2f491ad5ec91ed2ef7511a26311de17e6c8cc36fd9bf",
