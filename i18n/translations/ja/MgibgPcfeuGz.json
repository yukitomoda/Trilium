    {
      "id": "u_996cab19015a94d3a9f7b8fb_0",
      "kind": "li",
      "source": "The widget must export a __TRILIUM_PH_0__ and not an instance of the class (e.g. __TRILIUM_PH_1__) because it needs to be multiplied for each note, so that splits work correctly.",
      "sourceHash": "996cab19015a94d3a9f7b8fbd18131e148bbb781a6682e60ee34b74ccc25e72e",
      "context": "Custom Widgets > Widget location (parent widget)",
      "contextHash": "6d6116f99dc63eb3f6bc3bd8c58f170ec7f35bded248d2951bd30b98d17c1c0d",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_c5dde00f00aabd9f8370d726_0",
      "kind": "li",
      "source": "Since the __TRILIUM_PH_0__ is exported instead of an instance, the __TRILIUM_PH_1__ getter must be __TRILIUM_PH_2__, otherwise the widget is ignored.",
      "sourceHash": "c5dde00f00aabd9f8370d726a97f28e396f484bc805b940aca612d1d0fd4eeb2",
      "context": "Custom Widgets > Widget location (parent widget)",
      "contextHash": "6d6116f99dc63eb3f6bc3bd8c58f170ec7f35bded248d2951bd30b98d17c1c0d",
      "status": "pending",
      "active": true
    },
