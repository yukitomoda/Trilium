    {
      "id": "u_0bdf50d78a00f96dbacded56_0",
      "kind": "p",
      "source": "The table view displays information in a grid, where the rows are individual notes and the columns are __TRILIUM_PH_0__Promoted Attributes__TRILIUM_PH_1__. In addition, values are editable.",
      "sourceHash": "0bdf50d78a00f96dbacded56245e956e151594ff94bf4595dbcb1323dceb6940",
      "context": "Table",
      "contextHash": "16d1c9050a0b32e83764a81d801a880773abedfd7f8b0b08a1cd87ca0e404f12",
      "status": "pending",
      "active": true
    },
    {
