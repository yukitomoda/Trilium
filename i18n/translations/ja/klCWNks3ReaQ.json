    },
    {
      "id": "u_26b69e3407dd2674011eb917_0",
      "kind": "p",
      "source": "If using __TRILIUM_PH_0__, then set the __TRILIUM_PH_1__environment variables in the service configuration__TRILIUM_PH_2__.",
      "sourceHash": "26b69e3407dd2674011eb917a017693d6d0be64e2a0d008420ec307e5efa9b3f",
      "context": "Multiple server instances",
      "contextHash": "47a618f02062622db30d2cdf22281cb8b0ae4b21583dc4ba46635ac1f55db13b",
      "status": "translated",
      "active": true,
      "translation": "__TRILIUM_PH_0__を使用する場合は、__TRILIUM_PH_1__サービス設定で環境変数を設定__TRILIUM_PH_2__してください。",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
        "glossaryHash": "87275a9e032d2599a1276554b41c0fed0509e3ed6ee1594f83705051d453ee50"
      },
