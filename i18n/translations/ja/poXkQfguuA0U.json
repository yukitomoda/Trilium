      "kind": "li",
      "source": "Alternatively, set the __TRILIUM_PH_0__ environment variable before starting Trilium.",
      "sourceHash": "8a2f1b2e3a81c03211f1c50ce92ec1a07ba126e6062ce8eea6ede91c69dda434",
      "context": "Desktop Installation > Startup Scripts",
