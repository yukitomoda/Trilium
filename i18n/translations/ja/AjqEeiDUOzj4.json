    {
      "id": "u_6429beb3d0812c16f8223d25_0",
      "kind": "p",
      "source": "__TRILIUM_PH_0__Text__TRILIUM_PH_1__ and __TRILIUM_PH_2__Markdown__TRILIUM_PH_3__ notes can embed an interactive media player directly in the note content. To do so, include the audio or video file:",
      "sourceHash": "6429beb3d0812c16f8223d25f8ee97329779029f679506482ed02d0de3b00c0c",
      "context": "Audio & Video > Including media in notes",
      "contextHash": "740e75abe3f9ed1c7758bc4aae1a7d516b7f65b54d1bedb00b6b5d9343b29135",
      "status": "pending",
      "active": true
    },
