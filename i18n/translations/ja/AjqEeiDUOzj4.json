      "active": true
    },
    {
      "id": "u_f7942793419f5334f1a08cd0_0",
      "kind": "li",
      "source": "Play next — when the current item ends, continue with the next one in the same parent note until the last item finishes.",
      "sourceHash": "f7942793419f5334f1a08cd0bfdd07d1ff656c8746970297730df5746a722210",
      "context": "Audio & Video > Interactions",
      "contextHash": "1ae63872b0f12c9e571837f1fe71fe052fbb31714472811f143e7f88d38ba5f3",
