    {
      "id": "u_98d589dbc2abcb92db7b0f80_0",
      "kind": "p",
      "source": "When entering the options, they are opened in a new __TRILIUM_PH_0__tab__TRILIUM_PH_1__. To close them, simply close the tab.",
