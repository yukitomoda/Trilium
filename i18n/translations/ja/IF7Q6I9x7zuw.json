    },
    {
      "id": "u_f12e0f2845dbc957a7682f1e_0",
      "kind": "p",
      "source": "On a __TRILIUM_PH_0__read-only__TRILIUM_PH_1__ dashboard, the widgets can't be moved or resized, notes dragged from the __TRILIUM_PH_2__Note Tree__TRILIUM_PH_3__ aren't added, and the menu of a widget no longer offers to remove it.",
      "sourceHash": "f12e0f2845dbc957a7682f1e9a4a5d418c293b35a77ec3513f77e18c563bbb9d",
      "context": "Dashboard > Read-only dashboards",
      "contextHash": "d219631c15076fc4e6905d5bd59bd6d55a3c2edbe626c38bf6a04c6bf4a622dd",
      "status": "pending",
