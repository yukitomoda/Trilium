    {
      "id": "u_de81a13e4a495d955adce3de_0",
      "kind": "p",
      "source": "See __TRILIUM_PH_0__Nginx Proxy Setup__TRILIUM_PH_1__ for more information about the Nginx setup.",
      "sourceHash": "de81a13e4a495d955adce3de7a5561e97183610f9b070ef6e0b2d5b704bc0c36",
      "context": "Synchronization fails with 504 Gateway Timeout > Nginx",
