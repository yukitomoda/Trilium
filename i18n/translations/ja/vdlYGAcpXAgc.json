    {
      "id": "u_e796a1c38054196f308b9718_0",
      "kind": "p",
      "source": "Synchronization can sometimes take a long amount of time in order to compute the items that require update. When running behind a reverse proxy, the request can time out.",
      "sourceHash": "e796a1c38054196f308b97188777c39906d508c3b025a8299db43f75eef65277",
      "context": "Synchronization fails with 504 Gateway Timeout",
      "contextHash": "05e74945b7289d8157741a6a671b9c05d4d94e9863070d880f3a56e2d24fc8af",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_efc2a89c1828d345ec9421ec_0",
      "kind": "p",
      "source": "The solution is to increase the timeout at proxy level.",
      "sourceHash": "efc2a89c1828d345ec9421ec6f91a178f6e1a55c772a273d5b2b5502478581b4",
      "context": "Synchronization fails with 504 Gateway Timeout",
