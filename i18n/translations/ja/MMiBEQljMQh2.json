    {
      "id": "u_0720cd9a17b5d1d528792ad3_0",
      "kind": "p",
      "source": "One of the Trilium's goals is to provide fast and comfortable navigation between notes.",
      "sourceHash": "0720cd9a17b5d1d528792ad31f3ae2e8281f5633b57edbf2b3e29a58220b7fe8",
      "context": "Note Navigation",
      "contextHash": "67ff82f36f3bb03730fd1b34b60997d7ab46d053ea190c0292584c92b9300ab1",
      "status": "translated",
      "active": true,
      "translation": "Triliumの目的の1つは、ノート間を高速で快適に行き来できるようにすることです。",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
        "glossaryHash": "87275a9e032d2599a1276554b41c0fed0509e3ed6ee1594f83705051d453ee50"
      },
      "translatedAt": "2026-11-14T16:50:34.717Z"
    },
    {
      "id": "u_1560e4f953b0bbebde9f7bd5_0",
      "kind": "h2",
      "source": "Backwards and forward__TRILIUM_PH_0__",
      "sourceHash": "1560e4f953b0bbebde9f7bd52888f7a9cf09df92784a24b35942e2d1c7909443",
      "context": "Note Navigation > Backwards and forward",
      "contextHash": "dcd8c20e6d6ecd8bc7b2fdee8dba63cf98926108f3f4075ad92206d2bb077510",
      "status": "translated",
      "active": true,
      "translation": "戻る・進む__TRILIUM_PH_0__",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
