    {
      "id": "u_3b195a7bb69179121ca90577_0",
      "kind": "p",
      "source": "The document is converted to a simplified representation on the server and rendered as read-only content, similar to a __TRILIUM_PH_0__Text__TRILIUM_PH_1__ note.",
      "sourceHash": "3b195a7bb69179121ca9057761d6f34b1f0805f18bb553bbb1400428226baa3f",
