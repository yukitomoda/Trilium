    {
      "id": "u_cb785624a75d7f2221b0f3a6_0",
      "kind": "p",
      "source": "See the dedicated section on PDFs in __TRILIUM_PH_0__Outline tab__TRILIUM_PH_1__.",
      "sourceHash": "cb785624a75d7f2221b0f3a6d57562963ed692c23f3553b05a8fb5509b1f321c",
      "context": "PDFs > Sidebar navigation",
