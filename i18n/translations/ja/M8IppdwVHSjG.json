    },
    {
      "id": "u_6b7021c1f814eb96a27ab607_0",
      "kind": "li",
      "source": "__TRILIUM_PH_0__ can optionally be __TRILIUM_PH_1__.",
      "sourceHash": "6b7021c1f814eb96a27ab60763fb4d17cd974bdf61986ac4ce893544aa92d1a9",
      "context": "Right pane widget > Key highlights for legacy widgets",
