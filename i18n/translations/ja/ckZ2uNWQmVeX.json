    {
      "id": "u_1b079aaeffb5c7b18c022077_0",
      "kind": "p",
      "source": "To import from an application, there are two ways to access the import dialog:",
      "sourceHash": "1b079aaeffb5c7b18c0220779926cb3129efc48ab39ca59a47c61096c1e52e9d",
      "context": "Importing data from other applications > Importing data from another application",
