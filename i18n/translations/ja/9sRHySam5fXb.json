    {
      "id": "u_12cc87e68ce46219c73afbc0_0",
      "kind": "p",
      "source": "Workspace is a concept built up on top of __TRILIUM_PH_0__note hoisting__TRILIUM_PH_1__. It is based on the idea that a user has several distinct spheres of interest. An example might be \"Personal\" and \"Work\", these two spheres are quite distinct and don't interact together. When I focus on Work, I don't really care about personal notes.",
      "sourceHash": "12cc87e68ce46219c73afbc053d6335deba87e471695305e494c0abe4cd24b0f",
      "context": "Workspaces",
      "contextHash": "1377264ba3b0a7172621971b49ac3e82e33b64b14328d9275d02807e67ea8460",
      "status": "pending",
      "active": true
    },
    {
