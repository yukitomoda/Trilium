      "active": true
    },
    {
      "id": "u_05a4b266b0aff51e17c5dd92_0",
      "kind": "li",
      "source": "Links to a specific heading in another note will still point to the right note, but the heading anchor will be dropped.",
      "sourceHash": "05a4b266b0aff51e17c5dd92775a1104863a016d5db0369841c66dd6d25204ef",
      "context": "Obsidian > Limitations",
      "contextHash": "1603434de813e28523fbdc55ce87100216a5a661d7f0e2f0a8ec9477b1291436",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_02ee8333755f9729b341eec1_0",
      "kind": "li",
      "source": "Dangling links (pointing to a note that doesn't exist) and ambiguous links (same base name in 2+ notes) are unwrapped to plain text.",
      "sourceHash": "02ee8333755f9729b341eec15898e45e84e158b92cf2935f8ca0b7d4e6c3845b",
      "context": "Obsidian > Limitations",
      "contextHash": "1603434de813e28523fbdc55ce87100216a5a661d7f0e2f0a8ec9477b1291436",
      "status": "pending",
