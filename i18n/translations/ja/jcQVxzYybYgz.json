    {
      "id": "u_548ad02fce2a41668dd28433_0",
      "kind": "h2",
      "source": "Differences between desktop and web__TRILIUM_PH_0__",
      "sourceHash": "548ad02fce2a41668dd284338910cd066a1c0d93a7a8e3e549963cc8fcdea8c5",
      "context": "Note contextual menu > Differences between desktop and web",
      "contextHash": "9fe0692eff544a8a0eed5cf6eb9c51265d8dde270a6070546ab3d9815b9af5db",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_0cfff32a315ba8f9cc077291_0",
      "kind": "p",
      "source": "The __TRILIUM_PH_0__web version__TRILIUM_PH_1__ behaves slightly different due to limitations imposed by web browsers:",
      "sourceHash": "0cfff32a315ba8f9cc077291645c32a60ce870498ab58f648bb1e566988a88d6",
      "context": "Note contextual menu > Differences between desktop and web",
      "contextHash": "9fe0692eff544a8a0eed5cf6eb9c51265d8dde270a6070546ab3d9815b9af5db",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_1382bd1cb8df18d01186ff28_0",
      "kind": "li",
      "source": "When no text is selected or a word is right-clicked, the browser's default contextual menu is displayed.",
      "sourceHash": "1382bd1cb8df18d01186ff28a930d805ab913d1724f66c8cf604e74b95412a6c",
      "context": "Note contextual menu > Differences between desktop and web",
      "contextHash": "9fe0692eff544a8a0eed5cf6eb9c51265d8dde270a6070546ab3d9815b9af5db",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_c6a63fd2eb6ab4eac1c952ed_0",
      "kind": "li",
      "source": "This is intentional since it preserves the __TRILIUM_PH_0__Spell Check__TRILIUM_PH_1__ functionality.",
      "sourceHash": "c6a63fd2eb6ab4eac1c952ed75c9ecc4de6fa5ab2478220752078deedac7ab74",
      "context": "Note contextual menu > Differences between desktop and web",
      "contextHash": "9fe0692eff544a8a0eed5cf6eb9c51265d8dde270a6070546ab3d9815b9af5db",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_cd3ac0a8ac8746a72f9ef142_0",
      "kind": "li",
      "source": "When a text is selected, a reduced menu is displayed instead which features only the functionality that is available within the browser version",
      "sourceHash": "cd3ac0a8ac8746a72f9ef1421520fba6ae8618f1f483124e0dd0750305713047",
      "context": "Note contextual menu > Differences between desktop and web",
      "contextHash": "9fe0692eff544a8a0eed5cf6eb9c51265d8dde270a6070546ab3d9815b9af5db",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_cf67a24c38faa0862d47effe_0",
      "kind": "li",
      "source": "__TRILIUM_PH_0__Paste__TRILIUM_PH_1__ is not available since the browser doesn't expose it, use __TRILIUM_PH_2__Ctrl__TRILIUM_PH_3__+__TRILIUM_PH_4__V__TRILIUM_PH_5__ instead.",
      "sourceHash": "cf67a24c38faa0862d47effeec649181d25c2f00eedea84aa5a03c740601dc4f",
      "context": "Note contextual menu > Differences between desktop and web",
      "contextHash": "9fe0692eff544a8a0eed5cf6eb9c51265d8dde270a6070546ab3d9815b9af5db",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_8dc65f7eeb67aaba88fafb65_0",
      "kind": "li",
      "source": "The browser menu can be triggered anyway by pressing __TRILIUM_PH_0__Shift__TRILIUM_PH_1__ + __TRILIUM_PH_2__Right click__TRILIUM_PH_3__.",
      "sourceHash": "8dc65f7eeb67aaba88fafb6581ebf0c8b08422321ba17f1410fc270618a39cda",
      "context": "Note contextual menu > Differences between desktop and web",
      "contextHash": "9fe0692eff544a8a0eed5cf6eb9c51265d8dde270a6070546ab3d9815b9af5db",
      "status": "pending",
