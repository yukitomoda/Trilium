    {
      "id": "u_7cdca0ff1f684a689177b825_0",
      "kind": "p",
      "source": "By default, any custom theme will be based on the legacy light theme. To use the TriliumNext theme instead, add the __TRILIUM_PH_0__ attribute onto the existing theme. The __TRILIUM_PH_1__ attribute must also be present.",
      "sourceHash": "7cdca0ff1f684a689177b82510251b5488cf5fa33f1b88e418a812e1a88fbe2e",
      "context": "Customize the Next theme",
      "contextHash": "62e8fb242f846470cbf7b69bba20e4c757c015eada1e4783e88761e33a40eee0",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_ebb886e96a63e4b92818af9d_0",
      "kind": "p",
      "source": "The __TRILIUM_PH_0__ label can be set to one of the following values:",
      "sourceHash": "ebb886e96a63e4b92818af9d2acab4db047e0a2d5900d75e9fdea21613fdc4cd",
      "context": "Customize the Next theme",
      "contextHash": "62e8fb242f846470cbf7b69bba20e4c757c015eada1e4783e88761e33a40eee0",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_96e39f10481cff0b0e9b178c_0",
      "kind": "li",
      "source": "__TRILIUM_PH_0__, for the TriliumNext (auto light or dark mode).",
      "sourceHash": "96e39f10481cff0b0e9b178c7935c7b4a4dd6fa94f25f93f04d75b5ad19ce089",
      "context": "Customize the Next theme",
      "contextHash": "62e8fb242f846470cbf7b69bba20e4c757c015eada1e4783e88761e33a40eee0",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_e249b1dcb695be48783c7fe5_0",
      "kind": "li",
      "source": "__TRILIUM_PH_0__, for the always light mode of the TriliumNext.",
      "sourceHash": "e249b1dcb695be48783c7fe5e5faae1e5f599aca6efca0a29c89ad3503638e29",
      "context": "Customize the Next theme",
      "contextHash": "62e8fb242f846470cbf7b69bba20e4c757c015eada1e4783e88761e33a40eee0",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_72fad68fe6c729907685ccb4_0",
      "kind": "li",
      "source": "__TRILIUM_PH_0__, for the always dark mode of the TriliumNext.",
      "sourceHash": "72fad68fe6c729907685ccb469445144765a2722ea591af40a737d249cf65bdb",
      "context": "Customize the Next theme",
      "contextHash": "62e8fb242f846470cbf7b69bba20e4c757c015eada1e4783e88761e33a40eee0",
