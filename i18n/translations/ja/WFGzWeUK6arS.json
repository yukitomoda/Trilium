    {
      "id": "u_50bd064499ea5a24d300ab20_0",
      "kind": "li",
      "source": "Any other value is ignored and will use the legacy white theme instead.",
      "sourceHash": "50bd064499ea5a24d300ab20467798b9963d0f1b3aec97ea72ca49298fbf88b8",
      "context": "Customize the Next theme",
