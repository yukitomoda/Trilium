    {
      "id": "u_d7bfa7bc2b7a77759c96b604_0",
      "kind": "p",
      "source": "Do note that the TriliumNext theme has a few more overrides than the legacy theme. Due to that, it is recommended to use __TRILIUM_PH_0__ with a next theme instead of the __TRILIUM_PH_1__ of a legacy theme.",
      "sourceHash": "d7bfa7bc2b7a77759c96b604091c4bb0fec88ea9a0f8973a9b4282986f5e152a",
