      "status": "pending",
      "active": true
    },
    {
      "id": "u_ccdcdc19e07204072271dc65_0",
      "kind": "p",
      "source": "In the __TRILIUM_PH_0__Note Tree__TRILIUM_PH_1__: ",
      "sourceHash": "ccdcdc19e07204072271dc6570b2641544647e65fde76a3fe100f17454fd3c3a",
      "context": "Custom AI quick actions > Creating a custom quick action",
      "contextHash": "f6a6b8afba2c51cab8f1d336e3585ec943bb252b5e78dfbbb18ba68204f65ed1",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_e25c9b9ce3a6ca013b1a910c_0",
      "kind": "li",
      "source": "Right-click the note where you want to place the quick action.",
      "sourceHash": "e25c9b9ce3a6ca013b1a910cce9b1191df59dc60942cb1cbc4ce6ec69d1da837",
      "context": "Custom AI quick actions > Creating a custom quick action",
      "contextHash": "f6a6b8afba2c51cab8f1d336e3585ec943bb252b5e78dfbbb18ba68204f65ed1",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_1d0208f9b36caa96f0c967b5_0",
      "kind": "li",
      "source": "Select __TRILIUM_PH_0__Insert child note__TRILIUM_PH_1__.",
      "sourceHash": "1d0208f9b36caa96f0c967b5e363eb933219746379cdb4eee8b99cfc1ebb37f0",
      "context": "Custom AI quick actions > Creating a custom quick action",
      "contextHash": "f6a6b8afba2c51cab8f1d336e3585ec943bb252b5e78dfbbb18ba68204f65ed1",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_4f7d78c0bef4f498ef652291_0",
      "kind": "li",
      "source": "Select __TRILIUM_PH_0__More__TRILIUM_PH_1__ → __TRILIUM_PH_2__AI Quick Action__TRILIUM_PH_3__. The entry appears only when AI is enabled.",
      "sourceHash": "4f7d78c0bef4f498ef652291174318864e0d73b6578927ac387d8049b14faa44",
      "context": "Custom AI quick actions > Creating a custom quick action",
      "contextHash": "f6a6b8afba2c51cab8f1d336e3585ec943bb252b5e78dfbbb18ba68204f65ed1",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_915276e7644c3103b2237a7e_0",
      "kind": "p",
      "source": "Afterwards, simply type in the content of the note the desired prompt. The text can be formatted in the same manner as a normal text note and it will be passed to the LLM as Markdown.",
      "sourceHash": "915276e7644c3103b2237a7e2a78e287961f76b7061dcea8e2aba53e240a0adf",
      "context": "Custom AI quick actions > Creating a custom quick action",
      "contextHash": "f6a6b8afba2c51cab8f1d336e3585ec943bb252b5e78dfbbb18ba68204f65ed1",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_b8b689024a82bdc3282ed1ec_0",
      "kind": "p",
      "source": "The title of the note will become the title of the quick action.",
      "sourceHash": "b8b689024a82bdc3282ed1ecefed49e3490dbc976363c6d2e0b79233dabc8ea3",
      "context": "Custom AI quick actions > Creating a custom quick action",
      "contextHash": "f6a6b8afba2c51cab8f1d336e3585ec943bb252b5e78dfbbb18ba68204f65ed1",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_b1127c181422d49309503f36_0",
      "kind": "p",
      "source": "Of note:",
      "sourceHash": "b1127c181422d49309503f36548a2c29f6b449d0cd3c4f00de23abc80b441818",
      "context": "Custom AI quick actions > Creating a custom quick action",
