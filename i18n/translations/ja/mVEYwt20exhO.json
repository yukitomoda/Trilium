      "context": "Custom AI quick actions > Creating a custom quick action",
      "contextHash": "f6a6b8afba2c51cab8f1d336e3585ec943bb252b5e78dfbbb18ba68204f65ed1",
      "status": "translated",
      "active": true,
      "translation": "__TRILIUM_PH_0__ノートツリー__TRILIUM_PH_1__で以下を行います: ",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
        "glossaryHash": "87275a9e032d2599a1276554b41c0fed0509e3ed6ee1594f83705051d453ee50"
