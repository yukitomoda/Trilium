    {
      "id": "u_0fd9a594e4b091a9fb03c321_0",
      "kind": "p",
      "source": "The breadcrumb allows quickly viewing the note hierarchy of the current note and navigating through it.",
      "sourceHash": "0fd9a594e4b091a9fb03c3212256a3e73cf7b4f9c4818de059306a41e8818474",
      "context": "Breadcrumb",
      "contextHash": "2bd873d6c734e63ea80e163a6a643f75bf87a3d24e3164987d176a2e3e5c567e",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_9e14895d4d2d7c347b7b0e5d_0",
      "kind": "p",
      "source": "It is part of the __TRILIUM_PH_0__Status bar__TRILIUM_PH_1__, displayed in the bottom-left of the screen.",
      "sourceHash": "9e14895d4d2d7c347b7b0e5d7239599ea0e97716d77297744cbb2edc5b4dc62e",
      "context": "Breadcrumb",
