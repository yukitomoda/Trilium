    {
      "id": "u_b1bae9e3ff6cb9dceab9944e_0",
      "kind": "p",
      "source": "A webview needs to know which URL to render, and it can be provided by setting the __TRILIUM_PH_0__ __TRILIUM_PH_1__label__TRILIUM_PH_2__, such as:",
      "sourceHash": "b1bae9e3ff6cb9dceab9944ea09965b709f3b8037541ce4616eed4d39e8a02e8",
      "context": "Web View > Configuration",
      "contextHash": "053136d3929a262856ab63412911aa70e3ae9668945e4730fb1b88ac7710d4c9",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_73a8e78ec6a0c868eeabb4cf_0",
      "kind": "p",
      "source": "The URL needs to contain the full scheme.",
      "sourceHash": "73a8e78ec6a0c868eeabb4cffa7f4232d10e2f2fc17e9f99df5fb20029618b38",
      "context": "Web View > Configuration",
      "contextHash": "053136d3929a262856ab63412911aa70e3ae9668945e4730fb1b88ac7710d4c9",
      "status": "pending",
      "active": true
