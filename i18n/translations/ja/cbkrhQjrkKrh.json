    {
      "id": "u_e942fde1f7fcb7fd05c6ff90_0",
      "kind": "li",
      "source": "__TRILIUM_PH_0__Initial Configuration__TRILIUM_PH_1__: When prompted, choose the option to set up sync with a sync server.",
      "sourceHash": "e942fde1f7fcb7fd05c6ff90253cb43aae790d372d7d4871c6cb0325c7fc3a40",
      "context": "Synchronization > Setting Up Synchronization > Synchronizing a Desktop Instance from a Sync Server",
      "contextHash": "c0e681036062da5c131793dddee78729ddaf856641744e90d7e97befcb44e652",
