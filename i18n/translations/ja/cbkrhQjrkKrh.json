    {
      "id": "u_90980707f9cce17ce1f4d39e_0",
      "kind": "p",
      "source": "For successful synchronization, both client and server must have the same date and time, with a tolerance of up to five minutes.",
      "sourceHash": "90980707f9cce17ce1f4d39e6a626c633f5a476a135bde484b9b16bf328635ff",
      "context": "Synchronization > Troubleshooting > Date/Time Synchronization",
