      "active": true
    },
    {
      "id": "u_ca4fd7186a9b79b7455529bf_0",
      "kind": "li",
      "source": "To select an attribute, press and hold it. Once an attribute is selected, tapping other attributes selects them as well.",
      "sourceHash": "ca4fd7186a9b79b7455529bfe3fd46c70a3251e113882db1a5baae8dd185daf0",
      "context": "Attributes tab > Mobile",
