    {
      "id": "u_e3fea80effd8c5d0abd03ace_0",
      "kind": "li",
      "source": "Attributes are added from the __TRILIUM_PH_0__ button in the header, or from the __TRILIUM_PH_1__ button above the __TRILIUM_PH_2__Definitions__TRILIUM_PH_3__ card.",
      "sourceHash": "e3fea80effd8c5d0abd03aceb308c96c4e70b306e2defc4a2827aa3c05d7e490",
