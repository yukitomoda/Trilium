      "active": true
    },
    {
      "id": "u_4e4fc272e1d831098ab11c37_0",
      "kind": "p",
      "source": "The following features are preserved by Trilium during the import process:",
      "sourceHash": "4e4fc272e1d831098ab11c37962bae9a80d1783ce2c30dc11d34966d9c46162e",
      "context": "Evernote > Supported features",
      "contextHash": "92869f1839516091a4d10693a4164bbdd68a99c5bf2cc38472ecdce41069dbe1",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_53b177b42087375590d84a54_0",
      "kind": "li",
      "source": "Basic formatting (bold, italic, underline, strikethrough, colors, highlights, superscript, subscript, text alignment, inline code).",
      "sourceHash": "53b177b42087375590d84a54dbd5f5886ae5c68459b325941598f1180c32743f",
      "context": "Evernote > Supported features",
      "contextHash": "92869f1839516091a4d10693a4164bbdd68a99c5bf2cc38472ecdce41069dbe1",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_81c9f7fb8a24e5ad8fd917cf_0",
      "kind": "li",
      "source": "The hierarchy of headings (these are shifted to start with H2 because H1 is reserved for note title, see __TRILIUM_PH_0__Headings__TRILIUM_PH_1__)",
      "sourceHash": "81c9f7fb8a24e5ad8fd917cf70ae0f9a42c2905d218e750dccf3e6454dc3ce5a",
      "context": "Evernote > Supported features",
      "contextHash": "92869f1839516091a4d10693a4164bbdd68a99c5bf2cc38472ecdce41069dbe1",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_ccb124045b4c52f0805ec456_0",
      "kind": "li",
      "source": "To-do lists. The new task format is collapsed to standard to-do lists",
      "sourceHash": "ccb124045b4c52f0805ec45690d1d9eb655836490453ce5ac7ad344250cc4513",
      "context": "Evernote > Supported features",
      "contextHash": "92869f1839516091a4d10693a4164bbdd68a99c5bf2cc38472ecdce41069dbe1",
      "status": "pending",
      "active": true
    },
    {
      "id": "u_245d2d015df50e08246aaffc_0",
      "kind": "li",
      "source": "__TRILIUM_PH_0__Images__TRILIUM_PH_1__ and __TRILIUM_PH_2__Attachments__TRILIUM_PH_3__",
