    {
      "id": "u_e5bbeff59cdd7d2939017b9c_0",
      "kind": "p",
      "source": "Trilium can import ENEX files, which are used by Evernote for backup/export. One ENEX file represents the content (notes and resources) of one notebook.",
      "sourceHash": "e5bbeff59cdd7d2939017b9c2815d19ec00c3d45ac009c0908dec84c6fdda403",
      "context": "Evernote",
      "contextHash": "5213036e6f48cea00f6b69badbcfb0069e52d2718b9fff68210e6818154209d8",
      "status": "pending",
      "active": true
    },
