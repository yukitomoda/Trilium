    {
      "id": "u_47717f581e80cff9c0578b1f_0",
      "kind": "p",
      "source": "Since v0.104.0, Canvas supports embedding notes in a similar fashion to the __TRILIUM_PH_0__Include Note__TRILIUM_PH_1__ functionality for __TRILIUM_PH_2__Text__TRILIUM_PH_3__ notes.",
      "sourceHash": "47717f581e80cff9c0578b1ffe096ef0b95013111af6485c73aafaaf148ade29",
