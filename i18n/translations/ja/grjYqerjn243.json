    {
      "id": "u_6dd42ff955ca4ccfffe38400_0",
      "kind": "p",
      "source": "Embedding notes in the canvas follows the same rules as __TRILIUM_PH_0__Include Note__TRILIUM_PH_1__: some notes are rendered as images (e.g. __TRILIUM_PH_2__Mind Map__TRILIUM_PH_3__), whereas some render fully interactive such as __TRILIUM_PH_4__Collections__TRILIUM_PH_5__.",
      "sourceHash": "6dd42ff955ca4ccfffe38400071061fc4237513f9917012789848bb42c950581",
      "context": "Canvas > Embedding notes",
      "contextHash": "5a4718a8aeb2dc23cdedb8cb3dd21d6460024e62917c4c130b7805875d090431",
      "status": "pending",
      "active": true
