    {
      "id": "u_2dbf6505a2ef4bb220d24275_0",
      "kind": "p",
      "source": "Note that Trilium polyfills __TRILIUM_PH_0__, __TRILIUM_PH_1__ and __TRILIUM_PH_2__ because they were required by one of our dependencies (the autocomplete).",
      "sourceHash": "2dbf6505a2ef4bb220d2427546635d7c19b406e75a2a1e96acd9612732cde259",
