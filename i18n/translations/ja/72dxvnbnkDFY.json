    {
      "id": "u_aea582d64f985b03d0feffbd_0",
      "kind": "p",
      "source": "Use native equivalents like __TRILIUM_PH_0__, __TRILIUM_PH_1__, __TRILIUM_PH_2__, and __TRILIUM_PH_3__ instead.",
      "sourceHash": "aea582d64f985b03d0feffbd561f28dc4a843647a3ed7b94a02a44568939e73e",
      "context": "v0.102.0: Upgrade to jQuery 4.0.0",
