    {
      "id": "u_98c6ec6d7982bffaf2cfb9fb_0",
      "kind": "p",
      "source": "This may affect custom scripts if they (or the custom jQuery libraries used) depend on the deprecated APIs.",
      "sourceHash": "98c6ec6d7982bffaf2cfb9fbdcd5b25cf458366b002ee2b89674e304ce9c782d",
