    {
      "id": "u_5bfc8a872a3d60880153570e_0",
      "kind": "p",
      "source": "An aside block sets content apart from the main text of a note, in a box that the main text can wrap around. It can hold any kind of content, such as formatted text, lists, tables or images, except another aside block.",
      "sourceHash": "5bfc8a872a3d60880153570e41a9e8d2efea7c8753dfc57c9ea3fc22613812ca",
      "context": "Aside blocks",
      "contextHash": "a396837f03b03dae793abc05346522c5de20601428936221d4ced4c84e274944",
      "status": "translated",
      "active": true,
      "translation": "アサイドブロックを使用すると、ノートのメインテキストとは別に、メインテキストが周囲に回り込むボックス内にコンテンツを配置できます。別のブロックの中に配置する場合を除き、整形済みテキスト、リスト、テーブル、画像など、あらゆる種類のコンテンツを格納できます。",
      "conditions": {
        "model": "gemini-3.5-flash-lite",
        "promptHash": "716065651310a44dc7b240e50ada9f3b18164cb6a2471ec2ca8dd86023f06415",
        "glossaryHash": "87275a9e032d2599a1276554b41c0fed0509e3ed6ee1594f83705051d453ee50"
      },
