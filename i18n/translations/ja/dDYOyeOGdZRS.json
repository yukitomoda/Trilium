    {
      "id": "u_c20d396c6a682556ceaf2630_0",
      "kind": "li",
      "source": "In the __TRILIUM_PH_0__Formatting toolbar__TRILIUM_PH_1__, go to __TRILIUM_PH_2__Insert__TRILIUM_PH_3__ → __TRILIUM_PH_4__ __TRILIUM_PH_5__Aside__TRILIUM_PH_6__.",
