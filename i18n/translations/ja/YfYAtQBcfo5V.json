    },
    {
      "id": "u_fa8514e7c17e14bf948ce8f8_0",
      "kind": "p",
      "source": "It is possible to customize the font size and foreground color for both inline and display-mode equations, just like any other text. For inline equations, the background color/highlight can also be adjusted.",
      "sourceHash": "fa8514e7c17e14bf948ce8f80622eb17c71613fa8ac5e3ccf38121aaf28c0992",
      "context": "Math Equations > Formatting the equation",
      "contextHash": "33cad7fa7ec062855eecba718d6e3f2945ebbf93e60ad36725796c5f1a36dc17",
