    {
      "id": "u_4883155b8b0a9d8b0529ef73_0",
      "kind": "p",
      "source": "Backlinks are maintained automatically and are read-only from this side. A backlink disappears when the note that created it removes the link; it cannot be deleted from the note being pointed at.",
